<%= turbo_frame_tag "comment-#{@comment.id}" do %>
  <div id="comment-<%= @comment.id %>"
       data-controller="highlight<%= ' expand' if @comment.root? && signed_in? && has_children? %>"
       class="bg-white rounded-lg border border-gray-200 transition-all duration-500 ease-out <%= indent_class %>">
    <div class="p-4">
      <%# Comment header %>
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2">
          <span class="text-sm font-semibold text-gray-800"><%= @comment.user.username %></span>
          <span class="text-xs text-gray-400"><%= time_ago_in_words(@comment.created_at) %> ago</span>
        </div>
        <% if owner? || (@comment.root? && signed_in? && has_children?) %>
          <div class="flex items-center gap-3">
            <% if owner? %>
              <%= link_to "Edit", edit_comment_path(@comment),
                    class: "text-xs text-indigo-600 hover:underline" %>
              <%= link_to "Delete", comment_path(@comment),
                    data: { turbo_method: :delete, turbo_confirm: "Delete this comment and all its replies?" },
                    class: "text-xs text-red-500 hover:underline" %>
            <% end %>
            <% if @comment.root? && signed_in? && has_children? %>
              <button data-action="expand#toggle" data-expand-target="btn"
                      class="text-xs text-gray-400 hover:text-gray-600 hover:underline">Collapse</button>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# Comment body %>
      <p class="text-sm text-gray-900 whitespace-pre-wrap"><%= @comment.body %></p>

      <%# Reply section (logged-in, not at max depth) %>
      <% if can_reply? %>
        <%= render(ReplyFormComponent.new(parent_comment: @comment)) %>
      <% end %>
    </div>

    <%# Children %>
    <% if signed_in? %>
      <div id="children-comment-<%= @comment.id %>"
           data-expand-target="children"
           class="px-4 pb-4">
        <% children.each do |child| %>
          <%= render(CommentComponent.new(comment: child, current_user: @current_user, children_map: @children_map)) %>
        <% end %>
      </div>
    <% elsif reply_count > 0 %>
      <div class="px-4 pb-3">
        <p class="text-xs text-gray-400 italic">
          <%= reply_count_label %> —
          <%= link_to "sign in to view", new_user_session_path, class: "underline" %>
        </p>
      </div>
    <% end %>
  </div>
<% end %>
