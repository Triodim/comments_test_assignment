<div id="reply-form-comment-<%= @parent_comment.id %>" class="mt-3" data-controller="reply">
  <button data-action="reply#toggle"
          class="text-xs text-indigo-600 hover:underline font-medium">Reply</button>
  <div data-reply-target="form" class="hidden mt-3">
    <%= render(CommentFormComponent.new(
          comment: Comment.new,
          url: comments_path,
          parent_id: @parent_comment.id,
          submit_label: 'Post Reply',
        )) %>
  </div>
</div>
