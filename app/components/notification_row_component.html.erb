<div id="notification-<%= @notification.id %>" class="<%= row_class %>">
  <div class="flex-1">
    <%= link_to comments_path(scroll_to: @notification.comment_id),
          class: link_class do %>
      <strong><%= @notification.actor.username %></strong> mentioned you in a comment
    <% end %>
    <p class="text-xs text-gray-400 mt-1"><%= time_ago_in_words(@notification.created_at) %> ago</p>
  </div>
  <% unless @notification.read? %>
    <%= link_to "Mark read", mark_as_read_notification_path(@notification),
          data: { turbo_method: :patch },
          class: "text-xs text-indigo-600 hover:underline shrink-0" %>
  <% end %>
</div>
