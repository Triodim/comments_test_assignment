<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "CommentApp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full flex flex-col bg-gray-50 overflow-hidden"
        data-scroll-to="<%= @scroll_to_id %>">
    <%# Navigation — fixed at top %>
    <nav class="shrink-0 bg-white border-b border-gray-200 px-6 py-3 flex items-center justify-between z-20">
      <div class="flex items-center gap-6">
        <%= link_to "CommentApp", root_path, class: "text-xl font-bold text-indigo-600" %>
      </div>
      <div class="flex items-center gap-4">
        <% if user_signed_in? %>
          <%= turbo_frame_tag "notification_badge" do %>
            <%= render(NotificationBadgeComponent.new(current_user: current_user)) %>
          <% end %>
          <span class="text-sm text-gray-600"><%= current_user.username %></span>
          <%= button_to "Sign out", destroy_user_session_path,
                method: :delete,
                data: { turbo: false },
                class: "text-sm text-gray-500 hover:text-red-600 bg-transparent border-0 cursor-pointer p-0" %>
        <% else %>
          <%= link_to "Login", new_user_session_path,
                class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
          <%= link_to "Sign up", new_user_registration_path,
                class: "text-sm font-medium bg-indigo-600 text-white px-3 py-1.5 rounded-md hover:bg-indigo-700" %>
        <% end %>
      </div>
    </nav>

    <%# Flash messages %>
    <% if notice %>
      <div class="shrink-0 bg-green-50 border-l-4 border-green-400 px-6 py-2 text-green-800 text-sm"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="shrink-0 bg-red-50 border-l-4 border-red-400 px-6 py-2 text-red-800 text-sm"><%= alert %></div>
    <% end %>

    <%# Two-column body — fills remaining height, no outer scroll %>
    <div class="flex-1 overflow-hidden flex gap-8 max-w-6xl w-full mx-auto px-6 py-6">
      <%# Sidebar — fixed, no scroll needed %>
      <aside class="w-56 shrink-0">
        <%= render(SidebarComponent.new(current_user: current_user)) %>
      </aside>

      <%# Main content — scrolls independently (pages can override via content_for :main_class) %>
      <main class="flex-1 min-w-0 <%= content_for?(:main_class) ? yield(:main_class) : 'overflow-y-auto' %>">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
