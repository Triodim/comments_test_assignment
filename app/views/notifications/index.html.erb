<div class="flex items-center justify-between mb-6">
  <h1 class="text-lg font-semibold text-gray-900">Notifications</h1>
  <% if @notifications.unread.any? %>
    <%= link_to "Mark all as read", mark_all_as_read_notifications_path,
          data: { turbo_method: :patch },
          class: "text-xs text-indigo-600 hover:underline" %>
  <% end %>
</div>

<% if @notifications.empty? %>
  <p class="text-gray-500 text-sm">No notifications yet.</p>
<% else %>
  <div class="flex flex-col gap-2" id="notifications-list">
    <% @notifications.each do |notification| %>
      <%= render(NotificationRowComponent.new(notification: notification)) %>
    <% end %>
  </div>
<% end %>
