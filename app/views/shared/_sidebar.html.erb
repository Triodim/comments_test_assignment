<div class="bg-white rounded-lg border border-gray-200 p-4">
  <% if user_signed_in? %>
    <div class="mb-4 pb-4 border-b border-gray-100">
      <p class="font-semibold text-gray-900 text-base"><%= current_user.username %></p>
      <p class="text-sm text-gray-500 mt-1">
        <%= current_user.comments.count %> comment<%= current_user.comments.count == 1 ? '' : 's' %>
      </p>
    </div>

    <nav class="flex flex-col gap-1">
      <%= link_to "All Comments", comments_path,
            class: "px-3 py-2 rounded-md text-sm font-medium #{current_page?(comments_path) ? 'bg-indigo-50 text-indigo-700' : 'text-gray-600 hover:bg-gray-50'}" %>
      <%= link_to "My Comments", mine_comments_path,
            class: "px-3 py-2 rounded-md text-sm font-medium #{current_page?(mine_comments_path) ? 'bg-indigo-50 text-indigo-700' : 'text-gray-600 hover:bg-gray-50'}" %>
      <%= link_to "Notifications", notifications_path,
            class: "px-3 py-2 rounded-md text-sm font-medium #{current_page?(notifications_path) ? 'bg-indigo-50 text-indigo-700' : 'text-gray-600 hover:bg-gray-50'}" %>
    </nav>
  <% else %>
    <p class="text-sm text-gray-500 mb-4">Sign in to join the conversation.</p>
    <div class="flex flex-col gap-2">
      <%= link_to "Login", new_user_session_path,
            class: "block text-center px-3 py-2 rounded-md text-sm font-medium border border-indigo-600 text-indigo-600 hover:bg-indigo-50" %>
      <%= link_to "Sign up", new_user_registration_path,
            class: "block text-center px-3 py-2 rounded-md text-sm font-medium bg-indigo-600 text-white hover:bg-indigo-700" %>
    </div>
  <% end %>
</div>
