<% if @success %>
  <% if @comment.root? %>
    <%# Prepend new root comment — no children yet so children_map is empty %>
    <%= turbo_stream.prepend "comments-list" do %>
      <%= render(CommentComponent.new(comment: @comment, current_user: current_user, children_map: {})) %>
    <% end %>
    <%# Reset the new-comment form %>
    <%= turbo_stream.replace "new-comment-form" do %>
      <div id="new-comment-form" class="bg-white rounded-lg border border-gray-200 p-4">
        <h2 class="text-sm font-semibold text-gray-700 mb-3">New Comment</h2>
        <%= render(CommentFormComponent.new(comment: Comment.new, url: comments_path)) %>
      </div>
    <% end %>
  <% else %>
    <%# Append reply into parent's children container %>
    <%= turbo_stream.append "children-comment-#{@comment.parent_id}" do %>
      <%= render(CommentComponent.new(comment: @comment, current_user: current_user, children_map: {})) %>
    <% end %>
    <%# Reset and hide the reply form %>
    <%= turbo_stream.replace "reply-form-comment-#{@comment.parent_id}" do %>
      <%= render(ReplyFormComponent.new(parent_comment: @comment.parent)) %>
    <% end %>
  <% end %>
<% else %>
  <%# Re-render form with errors %>
  <%= turbo_stream.replace "new-comment-form" do %>
    <div id="new-comment-form" class="bg-white rounded-lg border border-gray-200 p-4">
      <div class="mb-2 text-sm text-red-600"><%= @comment.errors.full_messages.to_sentence %></div>
      <%= render(CommentFormComponent.new(comment: @comment, url: comments_path)) %>
    </div>
  <% end %>
<% end %>
