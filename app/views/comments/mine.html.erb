<h1 class="text-lg font-semibold text-gray-900 mb-6">My Comments</h1>

<% if @comments.empty? %>
  <p class="text-gray-500 text-sm">You haven't posted any comments yet.</p>
<% else %>
  <div class="flex flex-col gap-3">
    <% @comments.each do |comment| %>
      <div id="comment-<%= comment.id %>" class="bg-white rounded-lg border border-gray-200 p-4">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1">
            <p class="text-gray-900 text-sm whitespace-pre-wrap"><%= comment.body %></p>
            <p class="text-xs text-gray-400 mt-2">
              <%= time_ago_in_words(comment.created_at) %> ago
              <% if comment.depth > 0 %>
                · <span class="italic">reply</span>
              <% end %>
            </p>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <%= link_to "Edit", edit_comment_path(comment),
                  class: "text-xs text-indigo-600 hover:underline" %>
            <%= link_to "Delete", comment_path(comment),
                  data: { turbo_method: :delete, turbo_confirm: "Delete this comment and all its replies?" },
                  class: "text-xs text-red-500 hover:underline" %>
          </div>
        </div>
        <div class="mt-2">
          <%= link_to "View in context →",
                comments_path(scroll_to: comment.id),
                class: "text-xs text-indigo-500 hover:underline" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
