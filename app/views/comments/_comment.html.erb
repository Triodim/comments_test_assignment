<%= turbo_frame_tag "comment-#{comment.id}" do %>
  <div id="comment-<%= comment.id %>"
       class="bg-white rounded-lg border border-gray-200 <%= comment.depth > 0 ? 'ml-6 mt-2' : '' %>">
    <div class="p-4">
      <%# Comment header %>
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2">
          <span class="text-sm font-semibold text-gray-800"><%= comment.user.username %></span>
          <span class="text-xs text-gray-400"><%= time_ago_in_words(comment.created_at) %> ago</span>
        </div>
        <% if user_signed_in? && current_user == comment.user %>
          <div class="flex gap-3">
            <%= link_to "Edit", edit_comment_path(comment),
                  class: "text-xs text-indigo-600 hover:underline" %>
            <%= button_to "Delete", comment_path(comment), method: :delete,
                  data: { turbo_confirm: "Delete this comment and all its replies?" },
                  class: "text-xs text-red-500 hover:underline bg-transparent border-0 cursor-pointer p-0" %>
          </div>
        <% end %>
      </div>

      <%# Comment body %>
      <p class="text-sm text-gray-900 whitespace-pre-wrap"><%= comment.body %></p>

      <%# Reply button (logged-in, not at max depth) %>
      <% if user_signed_in? && comment.depth < 2 %>
        <div class="mt-3" data-controller="reply">
          <button data-action="reply#toggle"
                  class="text-xs text-indigo-600 hover:underline font-medium">Reply</button>
          <div data-reply-target="form" class="hidden mt-3">
            <%= render "form",
                  comment: Comment.new,
                  url: comments_path,
                  parent_id: comment.id,
                  submit_label: "Post Reply" %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Children %>
    <% if user_signed_in? %>
      <div id="children-comment-<%= comment.id %>" class="px-4 pb-4">
        <% comment.children.each do |child| %>
          <%= render "comment", comment: child %>
        <% end %>
      </div>
    <% elsif comment.children.any? %>
      <div class="px-4 pb-3">
        <p class="text-xs text-gray-400 italic">
          <%= comment.children.count %> repl<%= comment.children.count == 1 ? 'y' : 'ies' %> —
          <%= link_to "sign in to view", new_user_session_path, class: "underline" %>
        </p>
      </div>
    <% end %>
  </div>
<% end %>
