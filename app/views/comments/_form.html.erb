<%= form_with model: comment, url: url, data: { turbo: true } do |f| %>
  <%= f.hidden_field :parent_id, value: local_assigns[:parent_id] %>
  <div class="mb-3">
    <%= f.text_area :body,
          rows: 3,
          placeholder: "Write your comment… use @username to mention someone",
          class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none" %>
  </div>
  <div class="flex justify-end">
    <%= f.submit local_assigns.fetch(:submit_label, "Post Comment"),
          class: "bg-indigo-600 text-white px-4 py-1.5 rounded-md text-sm hover:bg-indigo-700 cursor-pointer" %>
  </div>
<% end %>
