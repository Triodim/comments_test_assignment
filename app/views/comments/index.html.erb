<% content_for :main_class, "flex flex-col overflow-hidden" %>

<%# Fixed header: search + new comment form %>
<div class="shrink-0 pb-4">
  <form action="<%= comments_path %>" method="get" class="mb-4"
        data-controller="search"
        data-search-url-value="<%= comments_path(format: :turbo_stream) %>">
    <div class="flex gap-2">
      <input type="text" name="q" value="<%= params[:q] %>"
             placeholder="Search comments..."
             autocomplete="off"
             data-search-target="input"
             data-action="input->search#query"
             class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
      <button type="button"
              data-search-target="clear"
              data-action="search#clear"
              class="px-4 py-2 text-sm text-gray-500 hover:text-gray-700 <%= params[:q].blank? ? 'hidden' : '' %>">Clear</button>
    </div>
  </form>

  <% if user_signed_in? %>
    <div id="new-comment-form" class="bg-white rounded-lg border border-gray-200 p-4">
      <h2 class="text-sm font-semibold text-gray-700 mb-3">New Comment</h2>
      <%= render(CommentFormComponent.new(comment: @new_comment, url: comments_path)) %>
    </div>
  <% else %>
    <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-4 text-sm text-indigo-700">
      <%= link_to "Sign in", new_user_session_path, class: "font-semibold underline" %> or
      <%= link_to "sign up", new_user_registration_path, class: "font-semibold underline" %>
      to post comments and see full threads.
    </div>
  <% end %>
</div>

<% if user_signed_in? %>
  <div data-controller="feed" class="shrink-0 flex items-center justify-end gap-3 pb-2">
    <button data-action="feed#expandAll"
            class="text-xs text-gray-400 hover:text-gray-600 hover:underline">Expand all</button>
    <button data-action="feed#collapseAll"
            class="text-xs text-gray-400 hover:text-gray-600 hover:underline">Collapse all</button>
  </div>
<% end %>

<%# Scrollable comments feed %>
<div id="comments-list" class="flex-1 overflow-y-auto flex flex-col gap-4 pr-1">
  <% if params[:q].present? %>
    <% if @comments.empty? %>
      <p class="text-gray-500 text-sm">No results for "<%= params[:q] %>".</p>
    <% else %>
      <% @comments.each do |comment| %>
        <%= render(CommentComponent.new(comment: comment, current_user: current_user, children_map: @children_map)) %>
      <% end %>
    <% end %>
  <% else %>
    <% if @comments.empty? %>
      <p class="text-gray-500 text-sm">No comments yet. Be the first!</p>
    <% else %>
      <% @comments.each do |comment| %>
        <%= render(CommentComponent.new(comment: comment, current_user: current_user, children_map: @children_map)) %>
      <% end %>
    <% end %>

    <%# Infinite scroll sentinel — replaced with next cursor or removed on last page %>
    <% if @next_cursor %>
      <div id="feed-sentinel"
           data-controller="infinite-scroll"
           data-infinite-scroll-url-value="<%= comments_path(cursor: @next_cursor, format: :turbo_stream) %>"
           class="py-6 flex justify-center">
        <span class="text-xs text-gray-300">Loading more…</span>
      </div>
    <% end %>
  <% end %>
</div>
