<div class="max-w-sm mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Create account</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <% if resource.errors.any? %>
      <div class="bg-red-50 border border-red-300 rounded-md p-3 mb-4">
        <ul class="list-disc list-inside text-sm text-red-700">
          <% resource.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="flex flex-col gap-4">
      <div>
        <%= f.label :username, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :username, autocomplete: "username",
              class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-indigo-500",
              placeholder: "e.g. alice_99" %>
        <p class="text-xs text-gray-400 mt-1">2–30 chars, letters/numbers/underscores only</p>
      </div>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "new-password",
              class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-indigo-500" %>
      </div>
      <%= f.submit "Create account",
            class: "w-full bg-indigo-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-indigo-700 cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-4 text-sm text-gray-600 flex flex-col gap-1">
    <%= render "devise/shared/links" %>
  </div>
</div>
